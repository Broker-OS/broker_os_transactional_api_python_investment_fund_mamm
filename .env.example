# ════════════════════════════════════════════════════════════════════════
#  Broker OS · Investment Fund MAM — configuracion
#  Copiar a .env y completar. El .env NUNCA se commitea.
# ════════════════════════════════════════════════════════════════════════

# ── App ──
ENVIRONMENT=development
DEBUG=true
HTTP_PORT=8200
ROOT_PATH=

# ── Base de datos ──
# BD PROPIA: no comparte esquema con el bridge PAMM.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brokeros_mam

# ── MAM API (proveedor) ──────────────────────────────────────────────────
# La URL y la key las entrega el proveedor por canal seguro. La key es de USO
# EXCLUSIVO DEL BACKEND: nunca al navegador, ni a una app movil, ni al repo.
MAM_API_BASE_URL=
MAM_API_KEY=

# Timeouts por tipo de operacion: lo que toca MT5 es mucho mas lento que una
# consulta, y crear una cuenta todavia mas.
MAM_TIMEOUT_READ_SECONDS=15
MAM_TIMEOUT_FINANCIAL_SECONDS=60
MAM_TIMEOUT_PROVISION_SECONDS=90

# Paginacion por cursor.
MAM_PAGE_SIZE=100
MAM_MAX_PAGES=50

# ── Provisioning MT5 ─────────────────────────────────────────────────────
# Grupo MT5 REAL asignado por el broker. SIN ESTO NO SE CREAN CUENTAS.
# Si el broker define un grupo unico para MAM, va aca y los dos de abajo vacios.
MAM_MT5_PLATFORM_GROUP=

# Grupos por capacidad. El broker los definio para el motor PAMM, que tenia roles
# rigidos. En MAM una cuenta puede ser leader y follower a la vez, pero el grupo
# se fija SOLO al crearla y no se puede mover despues: por eso se elige por la
# capacidad con la que NACE. Se puede pisar por request con `platform_group`.
MAM_MT5_GROUP_LEADER=
MAM_MT5_GROUP_FOLLOWER=
MAM_MT5_DEFAULT_LEVERAGE=100
MAM_MT5_SERVER=

# Mascaras de permisos MT5. La integracion soporta EXACTAMENTE dos perfiles:
#   9073 (0x2371) trading habilitado  |  8981 (0x2315) trading deshabilitado
# Si se omite el campo, el proveedor usa 1 (0x1), que no es ninguno de los dos.
# Validar ambas contra el servidor MT5 del broker antes de produccion.
MAM_MT5_RIGHTS_TRADING_ENABLED=9073
MAM_MT5_RIGHTS_TRADING_DISABLED=8981

# El copy trading exige HEDGING; con otro modo el motor rechaza las allocations.
MAM_ACCOUNT_MODE=HEDGING

# ── Limite de producto ───────────────────────────────────────────────────
# Cuantas estrategias puede seguir un cliente a la vez. Este limite NO vive en
# el motor MAM: se resuelve aca y se envia en cada suscripcion. Es el valor por
# defecto cuando el cliente no tiene un cupo propio.
MAM_DEFAULT_MAX_ACTIVE_LEADERS=1

# ── Webhook de terminacion de allocations ────────────────────────────────
# El signing_secret se entrega EN CLARO UNA SOLA VEZ al registrar el webhook.
# Sin el no se puede verificar ningun evento, asi que no se procesan.
MAM_WEBHOOK_SIGNING_SECRET=
MAM_WEBHOOK_PUBLIC_URL=
MAM_WEBHOOK_NAME=broker-os-crm
MAM_WEBHOOK_MAX_SKEW_SECONDS=300

# ── Cifrado de credenciales MT5 en reposo ────────────────────────────────
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta clave el provisioning falla cerrado: no se guardan contrasenas en claro.
MT5_CREDENTIALS_ENCRYPTION_KEY=

# ── Contabilidad ─────────────────────────────────────────────────────────
LEDGER_CURRENCY=USD

# ── Depositos on-chain (EVM) ─────────────────────────────────────────────
# Por defecto BNB Smart Chain TESTNET (chain id 97).
EVM_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
EVM_CHAIN_ID=97
EVM_NETWORK_NAME=BSC Testnet
# Address NUESTRA que recibe el dinero: si el token no llego aca, no cuenta.
EVM_RECEIVING_ADDRESS=
EVM_USDC_CONTRACT=
EVM_TOKEN_SYMBOL=USDC
# OJO: en BSC los tokens suelen tener 18 decimales; el USDC de Ethereum tiene 6.
# Un valor equivocado lee los montos mal por 12 ordenes de magnitud.
EVM_TOKEN_DECIMALS=18
EVM_MIN_CONFIRMATIONS=12
EVM_HTTP_TIMEOUT_SECONDS=20
CRYPTO_DEPOSIT_AUTO_CREDIT=true

# ── Email para OTP ───────────────────────────────────────────────────────
# Transporte preferido: AWS SES. Si no esta configurado se intenta SMTP; si
# tampoco, el envio queda deshabilitado y el OTP vuelve en la respuesta (dev).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
FUNDING_OTP_EMAIL=

# ── OTP (fondeo de la cuenta maestra) ────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
